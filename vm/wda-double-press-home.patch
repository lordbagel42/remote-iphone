+// A Home-button iPhone opens the app switcher on a double press of Home. Two pressButton calls
+// arrive about 0.5 s apart (XCTest waits around each), too slow for iOS to see a double press, so
+// this sends both Home (Consumer page 0x0C, Menu 0x40) events straight to testmanagerd, the second
+// `interval` seconds (default 0.15) after the first, without waiting for the first to complete.
++ (id<FBResponsePayload>)handleDoublePressHome:(FBRouteRequest *)request
+{
+  NSNumber *intervalArg = request.arguments[@"interval"];
+  double interval = nil == intervalArg ? 0.15 : MAX(0.0, MIN(1.0, intervalArg.doubleValue));
+  NSError *error;
+  id first = FBCreateXCDeviceEvent(0x0C, 0x40, 0.05, &error);
+  id second = nil == first ? nil : FBCreateXCDeviceEvent(0x0C, 0x40, 0.05, &error);
+  if (nil == second) {
+    return FBResponseWithUnknownError(error);
+  }
+  id<XCTMessagingChannel_RunnerToDaemon> proxy = [FBXCTestDaemonsProxy testRunnerProxy];
+  __block NSError *innerError = nil;
+  [FBRunLoopSpinner spinUntilCompletion:^(void (^completion)(void)) {
+    __block NSInteger pending = 2;
+    NSObject *lock = [NSObject new];
+    void (^done)(NSError *) = ^(NSError *invokeError) {  // completions arrive on XCTest's queues
+      BOOL last;
+      @synchronized (lock) {
+        if (nil != invokeError && nil == innerError) {
+          innerError = invokeError;
+        }
+        last = --pending == 0;
+      }
+      if (last) {
+        completion();
+      }
+    };
+    [proxy _XCT_performDeviceEvent:first completion:done];
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(interval * NSEC_PER_SEC)),
+                   dispatch_get_global_queue(QOS_CLASS_USER_INTERACTIVE, 0), ^{
+      [proxy _XCT_performDeviceEvent:second completion:done];
+    });
+  }];
+  if (nil != innerError) {
+    return FBResponseWithUnknownError(innerError);
+  }
+  return FBResponseWithOK();
+}
