+/**
+ Sends the next queued record alone, or all consecutive queued touches merged into one record: each
+ finger starts after the one before lifts (at least 50 ms later), keeping up to 400 ms of the spacing
+ they arrived with, so two taps on one spot stay two taps. After testmanagerd stalled, touches older
+ than 2 s are dropped rather than replayed onto whatever the screen shows by now. The record's
+ completion sends what queued meanwhile. Call with the class locked.
+ */
++ (void)sendQueuedEvents
+{
+  CFAbsoluteTime now = CFAbsoluteTimeGetCurrent();
+  NSMutableArray<NSDictionary *> *batch = [NSMutableArray array];
+  while (pendingEvents.count) {
+    NSDictionary *entry = pendingEvents.firstObject;
+    if (entry[@"record"] && batch.count) break;
+    [pendingEvents removeObjectAtIndex:0];
+    if (eventsStalled && entry[@"points"] && now - [entry[@"arrived"] doubleValue] > 2) {
+      void (^done)(NSError *) = entry[@"done"];
+      dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+        done([[FBErrorBuilder builder] withDescription:@"dropped: waited over 2 s for an earlier gesture"].build);
+      });
+      continue;
+    }
+    [batch addObject:entry];
+    if (entry[@"record"]) break;
+  }
+  eventsStalled = NO;
+  eventInFlight = batch.count > 0;
+  if (!eventInFlight) return;
+
+  XCSynthesizedEventRecord *event = batch.firstObject[@"record"];
+  double end = 0;
+  if (!event) {
+    event = [[XCSynthesizedEventRecord alloc] initWithName:@"touch" interfaceOrientation:UIInterfaceOrientationPortrait];
+    double start = 0, arrived = [batch.firstObject[@"arrived"] doubleValue];
+    end = -1;
+    for (NSDictionary *entry in batch) {
+      NSArray<NSArray<NSNumber *> *> *points = entry[@"points"];
+      start = MAX(start + MIN([entry[@"arrived"] doubleValue] - arrived, 0.4), end + 0.05);
+      arrived = [entry[@"arrived"] doubleValue];
+      double t0 = points[0][2].doubleValue / 1000.0, last = 0;
+      XCPointerEventPath *path = [[XCPointerEventPath alloc] initForTouchAtPoint:CGPointMake(points[0][0].doubleValue, points[0][1].doubleValue)
+                                                                         offset:start];
+      for (NSUInteger i = 1; i < points.count; i++) {
+        last = MAX(last, points[i][2].doubleValue / 1000.0 - t0);
+        [path moveToPoint:CGPointMake(points[i][0].doubleValue, points[i][1].doubleValue) atOffset:start + last];
+      }
+      [path liftUpAtOffset:start + last];
+      [event addPointerEventPath:path];
+      end = start + last;
+    }
+  }
+
+  NSUInteger number = ++eventRecordNumber;
+  void (^finish)(NSError *, BOOL) = ^(NSError *error, BOOL stalled) {
+    @synchronized (self) {
+      if (number != eventRecordNumber) return;
+      eventRecordNumber++;
+      eventsStalled = stalled;
+      [self sendQueuedEvents];
+    }
+    for (NSDictionary *entry in batch) {
+      ((void (^)(NSError *))entry[@"done"])(error);
+    }
+  };
+  // Should testmanagerd never answer, later events must not wait forever. Records from elsewhere (typing
+  // can run long) get a minute beyond their length.
+  double patience = MAX(end, event.maximumOffset) + (batch.firstObject[@"record"] ? 60 : 10);
+  dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(patience * NSEC_PER_SEC)),
+                 dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+    finish([[FBErrorBuilder builder] withDescription:@"testmanagerd did not answer in time"].build, YES);
+  });
+  [[XCUIDevice.sharedDevice eventSynthesizer] synthesizeEvent:event completion:(id)^(BOOL result, NSError *invokeError) {
+    finish(invokeError, NO);
+  }];
+}
