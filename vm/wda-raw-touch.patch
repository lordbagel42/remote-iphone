+
++ (NSUInteger)enqueue:(NSDictionary *)entry
+{
+  @synchronized (self) {
+    if (!pendingEvents) pendingEvents = [NSMutableArray array];
+    NSUInteger ahead = pendingEvents.count + (eventInFlight ? 1 : 0);
+    [pendingEvents addObject:entry];
+    if (!eventInFlight) [self sendQueuedEvents];
+    return ahead;
+  }
+}
