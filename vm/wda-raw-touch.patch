+/**
+ One finger along {"points": [[x, y, ms], ...]} (screen points, ms since touch-down), lifted at the last point.
+ Unlike /actions it skips the active-application lookup, element resolution and the wait for the app to
+ settle: it goes straight into the queue of events for testmanagerd (FBXCTestDaemonsProxy), which merges
+ touches that pile up into one gesture. By default it answers once the touch is done, with how long that
+ took; with "wait": false it answers at once, so a live viewer's touches never wait on HTTP round trips.
+ */
++ (id<FBResponsePayload>)handleRawTouch:(FBRouteRequest *)request
+{
+  NSArray *points = request.arguments[@"points"];
+  BOOL valid = [points isKindOfClass:NSArray.class] && points.count >= 1 && points.count <= 200;
+  for (id point in valid ? points : @[]) {
+    valid = valid && [point isKindOfClass:NSArray.class] && [point count] == 3;
+    for (id value in valid ? point : @[]) {
+      valid = valid && [value isKindOfClass:NSNumber.class] && isfinite([value doubleValue]);
+    }
+  }
+  if (!valid) {
+    return FBResponseWithStatus([FBCommandStatus invalidArgumentErrorWithMessage:@"points must be 1 to 200 [x, y, ms] number triples" traceback:nil]);
+  }
+  if ([request.arguments[@"wait"] isEqual:@NO]) {
+    return FBResponseWithObject(@{@"queued": @([FBXCTestDaemonsProxy enqueueTouch:points completion:nil])});
+  }
+  CFAbsoluteTime start = CFAbsoluteTimeGetCurrent();
+  __block NSError *error = nil;
+  [FBRunLoopSpinner spinUntilCompletion:^(void(^completion)(void)){
+    [FBXCTestDaemonsProxy enqueueTouch:points completion:^(NSError *touchError) {
+      error = touchError;
+      completion();
+    }];
+  }];
+  if (error) {
+    return FBResponseWithUnknownError(error);
+  }
+  return FBResponseWithObject(@{@"ms": @((CFAbsoluteTimeGetCurrent() - start) * 1000)});
+}
