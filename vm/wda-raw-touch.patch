++ (NSUInteger)enqueueTouch:(NSArray<NSArray<NSNumber *> *> *)points completion:(void (^)(NSError *))completion
+{
+  void (^done)(NSError *) = completion ?: ^(NSError *error) {
+    if (error) [FBLogger logFmt:@"Queued touch failed: %@", error.localizedDescription];
+  };
